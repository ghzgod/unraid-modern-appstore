<?php
/* Unraid Modern App Store: settings page (Settings -> Utilities -> Unraid Modern App Store). */
require_once "$docroot/plugins/dynamix/include/Wrappers.php";

$gas_dir  = "/boot/config/plugins/modern.appstore";
$gas_cfg  = "$gas_dir/modern.appstore.cfg";
$gas_cron = "$gas_dir/modern.appstore.cron";
$gas_php  = "/usr/local/emhttp/plugins/modern.appstore/fetch_stars.php";
$gas_msg  = "";

if (!is_dir($gas_dir)) @mkdir($gas_dir, 0755, true);

function gas_write_cfg($path, $token, $service, $notifications, $datadir, $scanDays, $defaultSort) {
    $token   = str_replace(["\"", "\n", "\r"], "", $token);
    $datadir = rtrim(str_replace(["\"", "\n", "\r"], "", $datadir), '/');
    if ($datadir === '') $datadir = '/boot/config/plugins/modern.appstore';
    $service = ($service === 'enabled') ? 'enabled' : 'disabled';
    $notifications = ($notifications === 'disabled') ? 'disabled' : 'enabled';
    $scanDays = gas_scan_days($scanDays);
    $defaultSort = gas_default_sort($defaultSort);
    $out = "TOKEN=\"$token\"\nSERVICE=\"$service\"\nNOTIFICATIONS=\"$notifications\"\nDATA_DIR=\"$datadir\"\nSCAN_DAYS=\"$scanDays\"\nDEFAULT_SORT=\"$defaultSort\"\n";
    file_put_contents($path, $out);
    @chmod($path, 0600);
    @mkdir($datadir, 0755, true);
}

// Only the intervals the cron line below can express, so a hand-edited config
// cannot write a schedule that never fires.
function gas_scan_days($v) {
    $v = (int)$v;
    return in_array($v, [1, 2, 3, 7], true) ? $v : 1;
}

// The grid's own SORT_OPTS list, mirrored here so a hand-edited config cannot
// name a sort order the grid does not have; anything unrecognised opens on
// Newest to the App Store instead.
function gas_default_sort($v) {
    $valid = ['name_asc', 'name_desc', 'downloads', 'new', 'updated', 'spotlight', 'trending',
              'newinstalls', 'popplugins', 'ghstars', 'ght1', 'ght7', 'ght30', 'ght365',
              'ghp1', 'ghp7', 'ghp30', 'ghp365', 'ghpall'];
    return in_array($v, $valid, true) ? $v : 'new';
}

function gas_write_cron($path, $scanDays = 1) {
    $php = "php /usr/local/emhttp/plugins/modern.appstore/fetch_stars.php";
    $scanDays = gas_scan_days($scanDays);
    // A full scan on the chosen interval, plus an hourly check that pulls only
    // NEWLY published app-store repos (it bypasses the manual-refresh cooldown).
    // The trending orders are differences between two full scans, so the
    // interval is also the finest trending window that can hold any data: on a
    // three-day schedule the "today" window compares a star count against
    // itself and every app reads as zero.
    $day = ($scanDays === 1) ? "*" : "*/$scanDays";
    $lines = "0 4 $day * * $php >/dev/null 2>&1\n23 * * * * $php --new-only 1 >/dev/null 2>&1\n";
    file_put_contents($path, $lines);
    @exec("/usr/local/sbin/update_cron 2>/dev/null");
}

if ($_POST) {
    if (isset($_POST['SAVE'])) {
        $token         = $_POST['TOKEN'] ?? '';
        $service       = $_POST['SERVICE'] ?? 'disabled';
        $notifications = $_POST['NOTIFICATIONS'] ?? 'enabled';
        $datadir       = $_POST['DATA_DIR'] ?? '';
        $scandays      = $_POST['SCAN_DAYS'] ?? '1';
        $defsort       = $_POST['DEFAULT_SORT'] ?? 'new';
        gas_write_cfg($gas_cfg, $token, $service, $notifications, $datadir, $scandays, $defsort);
        gas_write_cron($gas_cron, $scandays);
        $gas_msg = "Settings saved.";
        if (trim($token) === '') {
            $gas_msg .= " WARNING: no token set - star counts are disabled.";
        }
    }
    if (isset($_POST['REFRESH'])) {
        @exec("nohup php " . escapeshellarg($gas_php) . " >/dev/null 2>&1 &");
        $gas_msg = "Refresh started in the background. Reload this page in a few minutes for updated stats.";
    }
}

$cfg = is_file($gas_cfg) ? @parse_ini_file($gas_cfg) : [];
$token         = $cfg['TOKEN'] ?? '';
$service       = $cfg['SERVICE'] ?? 'enabled';
$notifications = (($cfg['NOTIFICATIONS'] ?? 'enabled') === 'disabled') ? 'disabled' : 'enabled';
$datadir       = $cfg['DATA_DIR'] ?? '/boot/config/plugins/modern.appstore';
$scandays      = (string)gas_scan_days($cfg['SCAN_DAYS'] ?? 1);
$defsort       = gas_default_sort($cfg['DEFAULT_SORT'] ?? 'new');

$status = @json_decode(@file_get_contents("/usr/local/emhttp/plugins/modern.appstore/status.json"), true) ?: [];
?>

<div markdown="1">
<?php if ($gas_msg): ?>
<span class="<?= (strpos($gas_msg,'WARNING')!==false) ? 'orange-text' : 'green-text' ?>"><?= htmlspecialchars($gas_msg) ?></span>
<?php endif; ?>
</div>

<form markdown="1" method="POST" action="/Settings/ModernAppStore">

_(Enable Unraid Modern App Store)_:
: <select name="SERVICE" size="1">
    <?= mk_option($service, "enabled", "Yes") ?>
    <?= mk_option($service, "disabled", "No") ?>
  </select>

> Turn the plugin on or off. When on, it adds GitHub star badges to the Community Applications app tiles and a sortable GitHub view.

_(Enable Notifications)_:
: <select name="NOTIFICATIONS" size="1">
    <?= mk_option($notifications, "enabled", "Yes") ?>
    <?= mk_option($notifications, "disabled", "No") ?>
  </select>

> When this is on, the plugin posts a notification to Unraid's own notification area if no GitHub token is configured. This is raised once when it starts, not on every scan.

_(GitHub Personal Access Token)_:
: <input type="password" name="TOKEN" value="<?= htmlspecialchars($token) ?>" style="width:520px;max-width:90%;" autocomplete="off" spellcheck="false">

> A GitHub personal access token is required. Without one the GitHub API allows only 60 requests per hour, which is far too few for the catalog; a token raises the limit to 5,000 per hour.
>
> Either kind of token works here; it makes no difference which one you use.
>
> To create a token, open <u><a href="https://github.com/settings/tokens/new" target="_blank">github.com/settings/tokens/new</a></u> (GitHub &rarr; Settings &rarr; Developer settings &rarr; Personal access tokens &rarr; Generate new token). Give it any name, leave all scopes unchecked since it only needs to read public star counts, click Generate token, and paste the value here.
>
> While this field is empty the Apps page shows a yellow warning and star counts stay disabled.

_(Refresh GitHub Trending Data)_:
: <select name="SCAN_DAYS" size="1">
    <?= mk_option($scandays, "1", "Every day") ?>
    <?= mk_option($scandays, "2", "Every 2 days") ?>
    <?= mk_option($scandays, "3", "Every 3 days") ?>
    <?= mk_option($scandays, "7", "Every week") ?>
  </select>

> How often every app's GitHub star count is fetched. The scan runs at 4am and takes one API request per repository, roughly 2,000 of the 5,000 an hour a token allows, so a daily scan is comfortable.
>
> This also sets the finest trending window that can hold data, because every trending order is the difference between two scans. On a three-day schedule **Trending (today)** compares a star count against itself and shows nothing at all; on a weekly one the daily and monthly windows both go flat. Leave this at **Every day** unless you have a reason not to.
>
> Newly published apps are picked up every hour regardless of this setting.

_(Default sort order)_:
: <select name="DEFAULT_SORT" size="1">
    <?= mk_option($defsort, "name_asc", "Name (A to Z)") ?>
    <?= mk_option($defsort, "name_desc", "Name (Z to A)") ?>
    <optgroup label="Unraid">
    <?= mk_option($defsort, "downloads", "Most Downloaded") ?>
    <?= mk_option($defsort, "new", "Recently Added") ?>
    <?= mk_option($defsort, "updated", "Recently Updated") ?>
    <?= mk_option($defsort, "spotlight", "Spotlight") ?>
    <?= mk_option($defsort, "trending", "Top Trending") ?>
    <?= mk_option($defsort, "newinstalls", "Top New Installs") ?>
    <?= mk_option($defsort, "popplugins", "Most Popular Plugins") ?>
    </optgroup>
    <optgroup label="GitHub">
    <?= mk_option($defsort, "ghstars", "Most Stars") ?>
    <?= mk_option($defsort, "ght1", "Most Stars Gained (today)") ?>
    <?= mk_option($defsort, "ght7", "Most Stars Gained (this week)") ?>
    <?= mk_option($defsort, "ght30", "Most Stars Gained (this month)") ?>
    <?= mk_option($defsort, "ght365", "Most Stars Gained (this year)") ?>
    <?= mk_option($defsort, "ghp1", "Fastest Growing (today)") ?>
    <?= mk_option($defsort, "ghp7", "Fastest Growing (this week)") ?>
    <?= mk_option($defsort, "ghp30", "Fastest Growing (this month)") ?>
    <?= mk_option($defsort, "ghp365", "Fastest Growing (this year)") ?>
    <?= mk_option($defsort, "ghpall", "Fastest Growing (all time)") ?>
    </optgroup>
  </select>

> The order the Apps page opens in. The page remembers whichever sort you picked last for 20 minutes, so paging back and forth keeps your place; past that window it opens back on this one.

_(Database directory)_:
: <input type="text" name="DATA_DIR" value="<?= htmlspecialchars($datadir) ?>" style="width:520px;max-width:90%;" spellcheck="false">

> Where the star database (stars.db) and the generated JSON files live. Defaults to this plugin's appdata folder on the cache pool so the data survives reboots. Change it only if you want the data stored elsewhere; the folder is created automatically.

&nbsp;
: <span class="buttons-spaced">
    <input type="submit" name="SAVE" value="_(Apply)_">
    <input type="submit" name="REFRESH" value="_(Refresh now)_">
    <input type="button" value="_(Done)_" onclick="done()">
  </span>

</form>

<div class="title"><span class="left">Last scan</span></div>
<?php if ($status): ?>
<div markdown="1">

Ran at:
: <?= $status['ran_at'] ? date('Y-m-d H:i:s', $status['ran_at']) : '-' ?>

Repos with a GitHub link:
: <?= (int)($status['repos_total'] ?? 0) ?>

Updated:
: <?= (int)($status['ok'] ?? 0) ?>

Unchanged:
: <?= (int)($status['not_modified'] ?? 0) ?>

Missing repos:
: <?= (int)($status['missing'] ?? 0) ?>

Rate limit remaining:
: <?= isset($status['rate_remaining']) ? (int)$status['rate_remaining'] : '-' ?>

Errors:
: <?= count($status['errors'] ?? []) ?>

</div>
<?php else: ?>
<div>No scan has run yet. Click <b>Refresh now</b> to populate star counts.</div>
<?php endif; ?>
