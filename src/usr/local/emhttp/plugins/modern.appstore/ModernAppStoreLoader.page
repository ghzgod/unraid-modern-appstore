<?php
/* Unraid Modern App Store: global loader.
 * Rides the same "Buttons" hook the custom.css plugin uses: this page body is
 * emitted into the chrome of EVERY webGUI page. We output the inject script
 * (which self-limits to /Apps) plus a tiny config object so the front-end knows
 * whether a token is configured (drives the yellow no-token warning). Emits
 * nothing when the plugin is disabled.
 */
$gas_cfg = "/boot/config/plugins/modern.appstore/modern.appstore.cfg";
$gas = is_file($gas_cfg) ? @parse_ini_file($gas_cfg) : [];
if (($gas['SERVICE'] ?? 'disabled') === 'enabled') {
    $gas_base = '/usr/local/emhttp/plugins/modern.appstore';
    $gas_jsv  = @filemtime("$gas_base/inject.js")  ?: time();
    $gas_cssv = @filemtime("$gas_base/inject.css") ?: time();
    $gas_has  = !empty(trim($gas['TOKEN'] ?? '')) ? 'true' : 'false';
    echo "<script>window.__modernAppStore={hasToken:$gas_has,settingsUrl:'/Settings/ModernAppStore'};</script>\n";
    echo "<link rel='stylesheet' type='text/css' href='/plugins/modern.appstore/inject.css?v=$gas_cssv'>\n";
    /* Class <html> inline, before CA's markup is parsed, so its stock grid,
       sort row and Results-Per-Page button never paint and then disappear.
       inject.js keeps this in step when the modern view is toggled off. */
    echo "<script>try{if(location.pathname.indexOf('/Apps')===0&&localStorage.getItem('asga_view_off')!=='1'){"
       . "document.documentElement.classList.add('asga-pre');"
       /* failsafe: if inject.js never runs (404, parse error, disabled JS) the
          class must not leave CA's own grid hidden behind nothing */
       . "setTimeout(function(){if(!window.__asgaAlive)document.documentElement.classList.remove('asga-pre');},5000);"
       . "}}catch(e){}</script>\n";
    echo "<script src='/plugins/modern.appstore/inject.js?v=$gas_jsv'></script>\n";
}
?>
